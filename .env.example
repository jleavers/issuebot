# Copy to .env (git-ignored) and fill in. Compose reads it for the profiles that choose which
# services run and for the ${VAR} references in compose.yaml, and hands the whole file to the
# worker container as its env_file.

# This checkout's role(s): the one hub on the host runs `hub,worker`; every other
# repository's checkout runs `worker` and points at the hub's database (see README,
# "More than one repository"). A plain `docker compose up` starts nothing without it.
COMPOSE_PROFILES=hub,worker

# Dedicated, repo-scoped GitHub token (contents, issues, pull requests: write; actions and
# commit statuses: read, so a session can read why a CI run failed). See the README's
# prerequisites for what a fine-grained token can and cannot reach.
GH_TOKEN=

# Claude auth: an API key, or leave empty and log in once inside the container
# (the claude-home volume, mounted at /home/agent/.claude, keeps the login).
ANTHROPIC_API_KEY=

# A long-lived OAuth token minted from a Claude subscription (`claude setup-token`). An
# alternative to the login in the volume, and the credential a *pool* of session accounts
# needs: each account has a home of its own and no login is shared between them, so a pooled
# ISSUEBOT_AGENT_USER (below) requires this or ANTHROPIC_API_KEY (README, "One account per
# concurrent session"; #121).
CLAUDE_CODE_OAUTH_TOKEN=

# Which account(s) the session runs as: `claude -p`, every hook and the clone, at a different
# uid from the worker (#75). The image defaults to `agent`, one account for the deployment,
# which every concurrent session then shares. A comma-separated list is a pool: the worker
# binds one member to each running slot, so two concurrent sessions sit at two uids and
# neither can enter the other's workspace (#121). The image builds agent-1..agent-3; set the
# line below (and one of the two credentials above) to turn the pool on.
# ISSUEBOT_AGENT_USER=agent-1,agent-2,agent-3

# Optional: Slack incoming webhook (https://hooks.slack.com/services/...) for notifications.
# WORKFLOW.md's notifications.slack.events picks the kinds (default: state_changed, blocked);
# changing either needs a worker restart.
SLACK_WEBHOOK_URL=

# The password of the shared PostgreSQL store, the one credential it has. Required, with no
# default: compose refuses to load compose.yaml at all while it is empty (the db, worker and
# web services name it, and interpolation runs before any profile is applied), so a fresh
# copy of this file starts nothing until you fill it in. The role is a cluster
# superuser and the database holds every registered repository's history and session
# transcripts, so treat it as an access credential rather than a setting: generate it
# (`openssl rand -hex 24`) instead of choosing it, keep it to letters, digits, `-`, `_` and
# `.` since compose splices it into a URL unencoded, and copy the hub's value into every other
# repository's worker checkout, which authenticates to the hub's database with it. The image
# applies it at initdb only, so on a cluster that already exists change it with ALTER ROLE
# first (README, "Rotating the database password"). Twelve characters or more also lets the
# transcript scrubber mask it as a bare word wherever it appears, not only inside a DSN.
ISSUEBOT_DB_PASSWORD=

# Identity for the commits the agent makes inside its workspace (passed through to
# claude and the hooks; the four GIT_AUTHOR_* / GIT_COMMITTER_* variables are the only
# git variables that pass through). An address that is not your own, like the default,
# leaves the commits linked to no GitHub account, which keeps the agent's work
# distinguishable from yours. Do not put your real address here if your account has
# "Keep my email addresses private" set: its "Block command line pushes that expose my
# email" option makes GitHub reject the agent's push with GH007 in the middle of a run,
# so the agent burns turns retrying and the issue escalates to review with an obscure
# cause. Your own ID+user@users.noreply.github.com address pushes cleanly but attributes
# every agent commit to you; for linked commits under a separate identity use a machine
# account's noreply address.
GIT_AUTHOR_NAME=issuebot
GIT_AUTHOR_EMAIL=issuebot@example.com
GIT_COMMITTER_NAME=issuebot
GIT_COMMITTER_EMAIL=issuebot@example.com

# Host port for the compose db service (container side stays 5432).
ISSUEBOT_DB_PORT=5432

# The dashboard's password, the one credential its every page and JSON route asks for (HTTP
# Basic: the browser prompts, any username, this value; `curl -u :"$ISSUEBOT_WEB_PASSWORD"`).
# Required, with no default: `issuebot web` refuses to start while it is empty, and the compose
# web service restarts until it is filled in. The dashboard serves every registered
# repository's transcripts, so generate it (`openssl rand -hex 24`) rather than choosing it.
# Only the hub's checkout needs it; a worker-only checkout leaves it empty.
ISSUEBOT_WEB_PASSWORD=

# Host port for the compose web service, the dashboard, published on loopback only
# (container side stays 8080, the --port in the web service's command).
ISSUEBOT_WEB_PORT=8080

# Optional: the PostgreSQL major version to bake into the worker image for a target repository
# whose tests need a server; empty installs nothing; changing it needs `docker compose build
# worker`. See the README, "A PostgreSQL server for the target repository's tests", for the
# WORKFLOW.md hooks that run one throwaway cluster per workspace.
ISSUEBOT_POSTGRES_VERSION=

# Optional: the Node major version to bake into the worker image for a target repository whose
# tests execute its own client-side JavaScript; empty installs nothing; changing it needs
# `docker compose build worker`. Pick the LTS line that repository's own CI runs on. See the
# README, "Node for the target repository's tests", for the WORKFLOW.md hook that installs the
# dependencies.
ISSUEBOT_NODE_VERSION=

# Optional: how many session accounts (`agent-1` .. `agent-N`) the worker image builds, which
# is what `agent.run_as` may then name as a pool so that concurrent sessions run at different
# uids (#121). The default matches agent.max_concurrent_agents; raise both together, and
# changing it needs `docker compose build worker`. See the README, "One account per concurrent
# session", which also covers the credential a pool needs in this file.
ISSUEBOT_AGENT_POOL_SIZE=3

# Optional: extra host names the session (and the worker) may reach, on top of the shipped
# default (#126). Under compose the worker's networks are all internal, so its one route off
# the host is the `egress` service, an allow-listing CONNECT proxy; the default list covers
# api.anthropic.com, statsig.anthropic.com, github.com, api.github.com,
# objects.githubusercontent.com and www.githubstatus.com, which is what the workflow itself
# needs and nothing else. The *target* repository's toolchain is what belongs here: the
# registries a `uv sync`, `pip install`, `npm ci` or `go mod download` in a hook or a session
# reaches. Commas or spaces, `name:port` for a port other than 443, and a leading dot for a
# domain and everything under it. Egress is HTTPS only: the proxy speaks CONNECT alone, so an
# http:// URL is refused whatever this says. Changing it needs `docker compose up -d egress`.
#   ISSUEBOT_EGRESS_ALLOW=pypi.org,files.pythonhosted.org,registry.npmjs.org
ISSUEBOT_EGRESS_ALLOW=

# Optional: how long Docker gives the worker to stop before SIGKILL, as a compose duration
# (120s, 10m20s). It has to exceed the orchestrator's shutdown wait, which is WORKFLOW.md's
# own hooks.timeout_ms + 20 s, so that a worker still running after_run is never killed
# mid-hook: the default covers the default 60 s timeout, and a workflow that raises the
# timeout for a slow after_create raises this too -- 600000 there wants 620s here. Changing
# it needs `docker compose up -d worker`, which recreates the container.
ISSUEBOT_STOP_GRACE_PERIOD=120s

# Optional: where the worker records events, runs, issue snapshots and its runtime snapshot
# (Phase 6). compose.yaml builds it for the worker and web containers from ISSUEBOT_DB_PASSWORD
# above (postgresql://issuebot:${ISSUEBOT_DB_PASSWORD}@db:5432/issuebot), so set it here only
# for a worker or the migrate/status/stats/refresh commands run on the host against the
# compose db: postgresql://issuebot:${ISSUEBOT_DB_PASSWORD}@127.0.0.1:${ISSUEBOT_DB_PORT}/issuebot
# (both the shell's `. ./.env` and compose expand the two references). The worker runs without
# history when it is unset; changing it needs a worker restart.
DATABASE_URL=
