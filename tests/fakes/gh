#!/usr/bin/env python3
"""Fake `gh` for runner tests: echoes argv, stdin and selected env as JSON, or misbehaves.

Scenario comes from FAKE_GH_SCENARIO: echo (default), fail (exit 1 with stderr), sleep,
flood (FAKE_GH_FLOOD_BYTES of output on FAKE_GH_FLOOD_STREAM, stdout by default; then a
10 s sleep when FAKE_GH_FLOOD_LINGER is set, else exit 0).
"""

import json
import os
import subprocess
import sys
import time

scenario = os.environ.get("FAKE_GH_SCENARIO", "echo")

# Write PID if pidfile is specified
pidfile = os.environ.get("FAKE_GH_PIDFILE")
if pidfile:
    with open(pidfile, "w") as f:
        f.write(str(os.getpid()))

if scenario == "sleep":
    time.sleep(10)
if scenario == "flood":
    # A response larger than the runner's cap: the flood goes out in chunks, and the process
    # can then linger, so a test can see that the cap killed it rather than waited it out.
    stream = sys.stderr if os.environ.get("FAKE_GH_FLOOD_STREAM") == "stderr" else sys.stdout
    remaining = int(os.environ.get("FAKE_GH_FLOOD_BYTES", "0"))
    while remaining > 0:
        chunk = min(remaining, 1 << 20)
        stream.write("x" * chunk)
        stream.flush()
        remaining -= chunk
    if os.environ.get("FAKE_GH_FLOOD_LINGER"):
        time.sleep(10)
    sys.exit(0)
if scenario == "fail":
    sys.stderr.write("gh: Not Found (HTTP 404)\n")
    sys.exit(1)

if sys.argv[1:3] == ["repo", "clone"] and len(sys.argv) > 4:
    # gh repo clone <repository> <directory> [-- <git flags>]: create a real repository.
    subprocess.run(["git", "init", "-q", sys.argv[4]], check=True)
    sys.exit(0)

payload = {
    "argv": sys.argv[1:],
    "stdin": sys.stdin.read(),
    "env": {
        key: os.environ.get(key)
        for key in (
            "GH_TOKEN",
            "GH_PROMPT_DISABLED",
            "GH_NO_UPDATE_NOTIFIER",
            "NO_COLOR",
            "GH_PAGER",
        )
    },
}
print(json.dumps(payload))
