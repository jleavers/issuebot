#!/usr/bin/env python3
"""Fake `gh` for runner tests: echoes argv, stdin and selected env as JSON, or misbehaves.

Scenario comes from FAKE_GH_SCENARIO: echo (default), fail (exit 1 with stderr), sleep.
"""

import json
import os
import subprocess
import sys
import time

scenario = os.environ.get("FAKE_GH_SCENARIO", "echo")

# Write PID if pidfile is specified
pidfile = os.environ.get("FAKE_GH_PIDFILE")
if pidfile:
    with open(pidfile, "w") as f:
        f.write(str(os.getpid()))

if scenario == "sleep":
    time.sleep(10)
if scenario == "fail":
    sys.stderr.write("gh: Not Found (HTTP 404)\n")
    sys.exit(1)

if sys.argv[1:3] == ["repo", "clone"] and len(sys.argv) > 4:
    # gh repo clone <repository> <directory> [-- <git flags>]: create a real repository.
    subprocess.run(["git", "init", "-q", sys.argv[4]], check=True)
    sys.exit(0)

payload = {
    "argv": sys.argv[1:],
    "stdin": sys.stdin.read(),
    "env": {
        key: os.environ.get(key)
        for key in (
            "GH_TOKEN",
            "GH_PROMPT_DISABLED",
            "GH_NO_UPDATE_NOTIFIER",
            "NO_COLOR",
            "GH_PAGER",
        )
    },
}
print(json.dumps(payload))
