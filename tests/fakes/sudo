#!/usr/bin/env python3
"""Fake `sudo` for the runas tests: accepts the options issuebot passes, records them, closes
the descriptors `-C` names as the real one does, and execs the command as the same uid.

CLAUDE_SUDO_RECORD names a file that receives the parsed options as JSON; CLAUDE_SUDO_DENY makes
every invocation fail the way an unlisted rule does; CLAUDE_SUDO_PRETEND_UID answers `id -u` with
that uid instead of running the command, which is how a delegation that works without separating
is tested (#111). It records into the *parent's* file
rather than the environment it was given, because the helper replaces that environment.
"""

import json
import os
import sys

args = sys.argv[1:]
opts = {"n": False, "u": None, "C": None}
while args:
    arg = args.pop(0)
    if arg == "--":
        break
    if arg == "-n":
        opts["n"] = True
    elif arg == "-u":
        opts["u"] = args.pop(0)
    elif arg == "-C":
        opts["C"] = int(args.pop(0))
    else:
        sys.stderr.write(f"fake sudo: unexpected option {arg!r}\n")
        sys.exit(64)
record = os.environ.get("CLAUDE_SUDO_RECORD")
if record:
    with open(record, "a", encoding="utf-8") as handle:
        handle.write(json.dumps({**opts, "command": args}) + "\n")
if os.environ.get("CLAUDE_SUDO_DENY"):
    sys.stderr.write("sudo: a password is required\n")
    sys.exit(1)
if not opts["n"] or not opts["u"] or not args:
    sys.stderr.write("fake sudo: -n, -u and a command are required\n")
    sys.exit(64)
if opts["C"] is not None:
    os.closerange(opts["C"], 4096)
pretend = os.environ.get("CLAUDE_SUDO_PRETEND_UID")
if pretend and args[-2:] == ["id", "-u"]:
    # The fake changes no uid, so a probe through it always sees the invoking one; this knob
    # answers the probe's `id -u` as the account would, which is the one thing the tests
    # cannot get from a real uid change.
    sys.stdout.write(pretend + "\n")
    sys.exit(0)
os.execvp(args[0], args)
